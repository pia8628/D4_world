import random
import time

def printer(text,delay=0.02):
    #打字機效果
    for ch in text:
        print(ch, end="",flush=True)
        time.sleep(delay)
    print("")
    

RoleList = ["野蠻人","法師","遊俠","德魯伊","死靈法師"]
#0野蠻人，1法師、2遊俠、3德魯伊、4死靈法師
WeaponList=[["末日使者","先祖之誓","拉瑪蘭迪的傑作"], #野蠻人
            ["焰疤","暴風增長奔雷杖","無盡怒火法杖"], #法師
            ["狩天弓","定罪","艾席拉的彎鉤匕首"], #遊俠
            ["屠夫切肉刀","盈月","老巫婆大法杖"], #德魯伊
            ["占卜罪惡","漆黑之河","分裂石像鬼巨劍"]] #死靈法師
WeaponAtk=[1235, 1050, 880]

class character:
    def __init__(self, name, role, level):
        self.name = name
        self.role = role
        self.level = level
        self.defense = 100
        self.attack = 100
        self.HP = 4000
        self.weapon = "赤手空拳" #武器名稱

    def PrintStatus(self): #列印角色狀態
        print("名稱:", self.name)
        print("職業:", RoleList[self.role])
        print("等級:", self.level)
        print("生命值:", self.HP)
        print("武器:", self.weapon)
        print("攻擊力", self.attack)
        
    def WetherPrintStatus(self): #詢問是否列印角色狀態
        wps=input("請問是否列印角色目前狀態? (Y/N)：")
        if wps == "Y":
            self.PrintStatus()
            input("請輸入任何鍵(Enter)繼續：")
    
    def Equip(self,n): #角色獲得裝備，n=0,1,2
        self.attack = self.attack + WeaponAtk[n]
        self.weapon = WeaponList[self.role][n]
    
    def Attack(self): #攻擊點數
        r = random.uniform(1, 1.1)
        att = round(self.attack * r)
        return att
    
    def Defend(self): #防禦點數
        pass

def battle(act, atk, bossHP, playerHP, BossNo): 
    #act攻擊或防禦 atk=.character.attack
    boss = random.choice([True, False])
    bossAtk = round(BossAtk[BossNo]*random.uniform(1,1.1))
    if act == True and boss == True:
        #玩家和魔王都攻擊
        printer(name+"和"+BossName[BossNo]+"衝向對方，互相攻擊！")
        bossHP = bossHP - atk
        playerHP = playerHP - bossAtk
        print("敵方血量: ", bossHP)
        print("玩家血量: ", playerHP)
        
    elif act == True and boss == False:
        #玩家攻擊，魔王防禦
        printer(name + "攻擊"+BossName[BossNo]+"！")
        atk = atk - 500
        bossHP = bossHP - atk
        print("敵方血量: ", bossHP)
        print("玩家血量: ", playerHP)
        
    elif act == False and boss == True:
        #玩家防禦，魔王攻擊
        printer(name + "緊緊握住盾牌，"+BossName[BossNo]+"大手一揮！")
        bossAtk = bossAtk - 500
        playerHP = playerHP - bossAtk
        print("敵方血量: ", bossHP)
        print("玩家血量: ", playerHP)
        
    else:
        #玩家和魔王都防禦
        printer(name+"和"+BossName[BossNo]+"停在原地採取防禦姿勢，緊盯著對方。")
    return(bossHP, playerHP)

BossName=["伊萊亞斯","莉莉絲"]
BossHP=[5000,8000] #敵方血量
BossAtk=[900,1200] #敵方攻擊力

def BossFight(BossNo):
    
    bossHP = BossHP[BossNo]
    cont = True #戰鬥是否繼續
    
    while cont:
        AorD = int(input("請選擇攻擊(0)或防禦(1)："))
        while AorD !=0 and AorD !=1:
            AorD = int(input("請選擇攻擊(0)或防禦(1)："))
        if AorD == 0:
            act = True
        else: act = False
        bossHP,c.HP = battle(act,c.attack, bossHP, c.HP, BossNo )
        
        if bossHP <=0 and c.HP>0 : #BOSS死亡，玩家存活
            print(BossName[BossNo]+"死亡，"+name+"存活，戰鬥結束。")
            cont = False
            result=1
        if bossHP >0 and c.HP<=0 : #BOSS存活，玩家死亡
            print(BossName[BossNo]+"存活，"+name+"死亡，戰鬥結束")
            cont = False
            result=2
        if bossHP <=0 and c.HP<=0 : #BOSS和玩家死亡
            print(BossName[BossNo]+"和"+name+"死亡，戰鬥結束")
            cont = False
            result=3
    return result
    
